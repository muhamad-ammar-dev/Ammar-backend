# ===== متغيرات البيئة للـ Backend =====
# انسخ الملف ده لاسم .env وحط القيم بتاعتك (في التطوير المحلي)،
# أو اكتبها في إعدادات خدمتك السحابية (الإنتاج).

# --- قاعدة البيانات ---
# لو سبتها فاضية => SQLite محلي (التطوير).
# للإنتاج حط connection string زي:
# DATABASE_URL=postgres://user:pass@host:5432/dbname?sslmode=require
DATABASE_URL=

# --- الحالة ---
# development (افتراضي: الكود بيتطبع في الكونسول) | production
NODE_ENV=development

# --- المنفذ ---
PORT=3000

# --- سر توقيع الـ JWT (إجباري — من غيره السيرفر مش هيشغل) ---
# ولّد قيمة عشوائية طويلة زي:
# JWT_SECRET=$(openssl rand -hex 24)
JWT_SECRET=

# --- إرسال الإيميل (كود التحقق) ---
# MAIL_PROVIDER=console    => الكود في الكونسول بس (تطوير)
# MAIL_PROVIDER=brevo     => Brevo (مجاني 300 إيميل/يوم) — https://brevo.com
# MAIL_PROVIDER=resend    => Resend — https://resend.com
MAIL_PROVIDER=console
BREVO_API_KEY=
BREVO_FROM_EMAIL=
BREVO_FROM_NAME=Ammar
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# --- SMS (شغال لاحقًا — مش لازم دلوقتي) ---
# SMS_PROVIDER=none | smsmisr | vonage
SMS_PROVIDER=none
SMS_MISR_USERNAME=
SMS_MISR_PASSWORD=
SMS_MISR_SENDER=
SMS_MISR_ENVIRONMENT=2
VONAGE_API_KEY=
VONAGE_API_SECRET=
VONAGE_FROM=

# --- OTP للتطوير ---
# لو حبيت كود ثابت أثناء التطوير (لو فاضية بيتولّد كود عشوائي):
DEV_OTP=

# --- مفتاح الإدارة (صاحب المنصة) ---
# نفس القيمة اللي هتكتبها في شاشة "إدارة الدفعات" جوه التطبيق.
# إجباري لفتح شاشات الإدارة — من غيره مفيش شاشة إدارة خالص.
# اعمله بقوة مثلًا:  openssl rand -hex 32
ADMIN_KEY=

# --- Firebase (تسجيل الدخول برقم الموبايل + إشعارات FCM) ---
# في Firebase Console: Settings ⚙ → Service accounts → Generate new private key
# → بينزّل ملف JSON (اسمه firebase-service-account.json في جذر المشروع).
# الأسهل: اكتب المسار بس، والسيرفر يقرا الـ project_id/client_email/private_key من الملف.
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
# أو حط القيم مباشرة (عشان الاستضافة السحابية اللي بتاخد key-value بس):
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=
